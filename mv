    private void OnDrawGizmos()
    {
        //move_vector
        Gizmos.color = _main._move_vector_color;
        Gizmos.DrawRay(transform.position + _main._move_vector_offset, _move_vector);
        Gizmos.DrawSphere(transform.position + _main._move_vector_offset, 0.05f);
        Gizmos.DrawSphere(transform.position + _main._move_vector_offset + new Vector3(_move_vector.x, _move_vector.y, 0), 0.05f);
    }
