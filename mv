using System.Collections;
using Unity.Mathematics;
using Unity.VisualScripting;
using UnityEngine;

public class MOVEMENT : MonoBehaviour
{
    public PLAYER_MAIN _main => GetComponentInParent<PLAYER_MAIN>();//заменить на индивидуальный
    public FOOT_STOP _foot_stop => GetComponentInParent<FOOT_STOP>();
    public FOOT _foot => GetComponentInParent<FOOT>();


    [SerializeField] private Rigidbody2D _rigid_body;
    [SerializeField] private float _speed_move = 0f;

    [SerializeField] public Vector2 _move_velocity = new Vector2(0f, 0f);

    [SerializeField] public Vector2 _move_vector = new Vector2(0f, 0f);

    //INPUTS
    [Header("INPUTS")]
    [SerializeField] public float _move_input = 0f;
    [SerializeField] public bool _input_jump_down = false;
    [SerializeField] public bool _input_jump_up = false;
    [SerializeField] public bool _input_run = false;
    [SerializeField] public bool _input_crouch = false;

    private void Start()
    {
        this.AddComponent<Rigidbody2D>();
        _rigid_body = GetComponent<Rigidbody2D>();
        _rigid_body.constraints = RigidbodyConstraints2D.FreezeRotation;//через палку можно добавлять параметры:  | RigidbodyConstraints2D.FreezePositionZ
        _rigid_body.gravityScale = _main._gravity_scale;
    }
    private void Update()
    {

        if (Time.timeScale == 0) { return; }

        _move_input = Input.GetAxisRaw("Horizontal");
        _input_jump_down = Input.GetButtonDown("Jump");//input_jump_button_down();
        _input_jump_up = Input.GetButtonUp("Jump");//input_jump_button_up();
        _input_run = Input.GetButton("Fire3") & !Input.GetButton("Fire1") & !_dashing ? true : false;//удалить в input managr  в Fire3 альтернативный ввод mouse 2
        _input_crouch = Input.GetButton("Fire1") & !Input.GetButton("Fire3") & !_dashing ? true : false;//удалить в input managr  в Fire1 альтернативный ввод mouse 0
        /*
        _input_battle_right = Input.GetButtonDown("Fire_right");
        _input_battle_left = Input.GetButtonDown("Fire_left");
        */

        if (_move_input > 0) { _main._vector = 1; }
        else if (_move_input < 0) { _main._vector = -1; }

        jump();
        velocity();
        dash();
        stomp();


        _rigid_body.linearVelocity = new Vector3(_move_velocity.x, _move_velocity.y, 0f);
    }




    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    /////////////////////////////////////////////- - - - - JUMP - - - - - ////////////////////////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    //[SerializeField] public float _input_jump_timer_down = 0f;
    //[SerializeField] public float _input_jump_timer_up = 0f;
    //[SerializeField] public float _input_jump_timer_value = 0.1f;
    //[SerializeField] public bool _pressed = false;
    //[SerializeField] public bool _unpressed = false;
    //
    [Header("JUMP")]
    [SerializeField] public float _jump_timer = 0f;
    [SerializeField] public bool _jumping = false;
    [SerializeField] public bool _jump_dubl = false;

    private void jump()
    {
        if (_main._grounded) { _jump_dubl = true; }

        if (_main._grounded & _input_jump_down)
        {
            StartCoroutine(jump_duration());
        }
        else if (!_main._grounded & _jump_dubl & _input_jump_down)
        {
            _jump_dubl = false;
            StopCoroutine(jump_duration());
            StartCoroutine(jump_duration());
        }
        else if (_input_jump_up)
        {
            _jumping = false;
        }
    }
    IEnumerator jump_duration()
    {
        _jumping = true;
        _dashing = false;
        _stomping = false;
        yield return new WaitForSeconds(_main._jump_time);
        _jumping = false;
    }
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    /////////////////////////////////////////////- - - - - DASH - - - - - ////////////////////////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

    //DASH
    [Header("DASH")]
    [SerializeField] public bool _dashing = false;
    [SerializeField] private bool _dash_cool_down = true;
    [SerializeField] private float _last_click_dash = 0;
    [SerializeField] private float _dash_time_dubl_click = 0.25f;
    [SerializeField] private float _last_vector = 0;
    [SerializeField] private DASH_PREFAB _dash;
    private void dash()
    {

        if (Input.GetButtonDown("Horizontal") & Input.GetAxisRaw("Horizontal") > 0f & _main._dash_can_right & _dash_cool_down)
        {
            if (Time.time - _last_click_dash <= _dash_time_dubl_click & _last_vector == Input.GetAxisRaw("Horizontal"))
            {
                _dash_cool_down = false;
                _dashing = true;
                _stomping = false;
                StartCoroutine(dashing());
                StartCoroutine(dash_train());
            }
            _last_click_dash = Time.time;
            _last_vector = Input.GetAxisRaw("Horizontal");
        }
        if (Input.GetButtonDown("Horizontal") & Input.GetAxisRaw("Horizontal") < 0f & _main._dash_can_left & _dash_cool_down)
        {
            if (Time.time - _last_click_dash <= _dash_time_dubl_click & _last_vector == Input.GetAxisRaw("Horizontal"))
            {
                _dash_cool_down = false;
                _dashing = true;
                _stomping = false;
                StartCoroutine(dashing());
                StartCoroutine(dash_train());
            }
            _last_click_dash = Time.time;
            _last_vector = Input.GetAxisRaw("Horizontal");
        }
    }
    IEnumerator dash_train()
    {
        while (_dashing)
        {
            //_move_velocity.x = _dash_power * _move_vector;

            _dash = Instantiate(_main._dash_prefab, transform.position, transform.rotation).GetComponent<DASH_PREFAB>();
            _dash._vector = _main._vector;
            _dash._destroy_time = _main._dash_destroy_time;
            yield return new WaitForSeconds(_main._dash_train_time);
        }
    }
    IEnumerator dashing()
    {
        yield return new WaitForSeconds(_main._dash_time);
        _dashing = false;
        yield return new WaitForSeconds(_main._dash_cool_down_time);
        _dash_cool_down = true;
    }

    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    /////////////////////////////////////////////- - - - - STOMP - - - - - ///////////////////////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    [Header("STONP")]
    [SerializeField] public bool _stomping = false;
    [SerializeField] public bool _stomp_cool_down = true;
    [SerializeField] public float _last_click_stomp = 0f;
    [SerializeField] public float _stomp_time_dubl_click = 0.25f;
    [SerializeField] public STOMP_PREFAB _stomp;




    private void stomp()
    {
        if (Input.GetButtonDown("Vertical") & Input.GetAxisRaw("Vertical") < 0f & !_main._grounded & _stomp_cool_down)
        {
            if (Time.time - _last_click_stomp <= _stomp_time_dubl_click)
            {
                _stomp_cool_down = false;
                _stomping = true;
                _dashing = false;
                StartCoroutine(stomping());
                StartCoroutine(stomp_train());
            }
            _last_click_stomp = Time.time;
        }
        else if (_main._grounded)
        {
            _stomping = false;
        }
    }
    IEnumerator stomp_train()
    {
        while (_stomping)
        {
            _stomp = Instantiate(_main._stomp_prefab, transform.position, transform.rotation).GetComponent<STOMP_PREFAB>();
            _stomp._vector = _main._vector;
            _stomp._destroy_time = _main._stomp_destroy_time;
            yield return new WaitForSeconds(_main._stomp_train_time);
        }
    }
    IEnumerator stomping()
    {
        yield return new WaitForSeconds(_main._stomp_cool_down_time);
        _stomp_cool_down = true;
        yield return new WaitForSeconds(_main._stomp_time_anti_soft_lock);
        _stomping = false;
    }








    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    /////////////////////////////////////////- - - - - velocity - - - - - //////////////////////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    private void velocity()
    {
        if (_move_input == 0f & _main._grounded)
        {
            _foot._FOOT.SetActive(false);
            _foot_stop._FOOT_STOP.SetActive(true);
        }
        else
        {
            _foot._FOOT.SetActive(true);
            _foot_stop._FOOT_STOP.SetActive(false);
        }

        _move_vector = new Vector2( (1f - math.abs(_main._ground_rotation / 90f)) * _move_input, _main._ground_rotation / 90f * _move_input).normalized;
       
        if (_main._grounded)
        {
            if (_input_crouch) { _speed_move = _main._speed_crouch; }
            else if (_input_run) { _speed_move = _main._speed_run; }
            else { _speed_move = _main._speed_move; }
        }

        if (_dashing)
        {
            _move_velocity.x = _main._speed_dash * _main._vector;
        }
        else
        {
            _move_velocity.x = _move_vector.x * _speed_move;
        }

        /////////////////////////////////////////////////////////////////////////////////
        if (_jumping) { _move_velocity.y = _main._jump_power; }
        else if (_dashing) { _move_velocity.y = 0; }
        else if (_stomping) { _move_velocity.y = -_main._max_velocity_y; }
        else
        {
            if (_main._grounded & _move_input != 0f)
            {
                _move_velocity.y = _move_vector.y * _speed_move + _main._move_corrector;
            }
            else if (_main._grounded & _move_input == 0f & _move_velocity.y > 0f)
            {
                _move_velocity.y = 0f;
            }
            else
            {
                _move_velocity.y = _rigid_body.linearVelocityY > -_main._max_velocity_y ? _rigid_body.linearVelocityY : -_main._max_velocity_y;
            }
        }
           
    }


